generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  addressLabel String?
  latitude     Float?
  longitude    Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  driverProfiles      DriverProfile[]
  orders              Order[]
  scanAssets          ScanAsset[]
  deliveryAssignments DeliveryAssignment[]
  punchEvents         PunchEvent[]
  locationPings       LocationPing[]
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  password           String?
  image              String?
  isSuperAdmin       Boolean   @default(false)
  isRestaurantAdmin  Boolean   @default(false)
  isDriver           Boolean   @default(false)
  tenantId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  accounts       Account[]
  sessions       Session[]
  authTokens     AuthToken[]
  driverProfile  DriverProfile?
  punchEvents    PunchEvent[]
  locationPings  LocationPing[]
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model AuthToken {
  id         String        @id @default(cuid())
  type       AuthTokenType
  token      String        @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, token])
  @@index([userId, type])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DriverProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  tenantId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryAssignments DeliveryAssignment[]

  @@index([tenantId])
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  tenantId             String
  externalId           String?
  customerName         String?
  customerPhone        String?
  deliveryAddressText  String
  latitude             Float?
  longitude            Float?
  status               OrderStatus @default(DRAFT)
  suggestedDriverId    String?
  orderedAt            DateTime    @default(now())
  requestedBy          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  scanAssets          ScanAsset[]
  deliveryAssignments DeliveryAssignment[]
  punchEvents         PunchEvent[]

  @@index([tenantId, status])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  name     String
  quantity Int    @default(1)
  notes    String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum ScanAssetStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model ScanAsset {
  id           String          @id @default(cuid())
  tenantId     String
  orderId      String?
  storageKey   String
  mimeType     String
  originalName String?
  status       ScanAssetStatus @default(UPLOADED)
  ocrText      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

enum DeliveryAssignmentStatus {
  SUGGESTED
  ACCEPTED
  ACTIVE
  COMPLETED
  CANCELLED
}

model DeliveryAssignment {
  id              String                    @id @default(cuid())
  tenantId        String
  orderId         String
  driverProfileId String
  status          DeliveryAssignmentStatus  @default(SUGGESTED)
  suggestedAt     DateTime                  @default(now())
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([driverProfileId, status])
}

enum PunchType {
  PICKED_UP
  DELIVERED
}

model PunchEvent {
  id        String    @id @default(cuid())
  tenantId  String
  orderId   String
  userId    String
  type      PunchType
  latitude  Float?
  longitude Float?
  punchedAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

model LocationPing {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  latitude  Float
  longitude Float
  accuracy  Float?
  recordedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, recordedAt])
}
